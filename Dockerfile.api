# syntax=docker/dockerfile:1

# ---- build ----
FROM golang:1.26-bookworm AS build
WORKDIR /src

# Dependencies first. This layer stays cached until go.mod or go.sum change,
# so editing source does not re-download the module graph on every build.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO off yields a statically linked binary, which is what allows the runtime
# image below to be a bare slim image with no libc version to match.
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/api ./cmd/api

# ---- runtime ----
# The API shells out to nothing. Its image is the binary and a certificate
# bundle, and that is the point: the service in the request path carries no
# video toolchain, so there is almost nothing in it to go wrong or be exploited.
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /out/api /usr/local/bin/api

EXPOSE 8080
CMD ["api"]
